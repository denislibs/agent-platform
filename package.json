{
  "name": "agent-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test && bun run test:ui && bun run test:web",
    "test:unit": "bun test packages/shared packages/core packages/testing packages/llm packages/search packages/agent packages/api/test/unit && bun run test:ui && bun run test:web",
    "test:ui": "bun test --preload ./packages/ui/test/dom.ts --path-ignore-patterns '**/node_modules/**' packages/ui",
    "test:web": "bun test --preload ./apps/web/test/dom.ts --path-ignore-patterns '**/node_modules/**' apps/web/test",
    "test:e2e:web": "bun run --cwd apps/web e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "ui:dev": "bun run --cwd packages/ui dev",
    "ui:build": "bun run --cwd packages/ui build",
    "web:dev": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "sandbox:build": "docker build -t agent-sandbox:dev docker/sandbox",
    "infra:up": "docker compose -f docker/compose.yml up -d",
    "infra:down": "docker compose -f docker/compose.yml down",
    "infra:reset": "docker compose -f docker/compose.yml down -v",
    "infra:wait": "bun scripts/wait-infra.ts",
    "db:generate": "cd packages/db && bunx --bun drizzle-kit generate",
    "db:migrate": "bun packages/db/src/migrate.ts",
    "worker": "bun packages/worker/src/main.ts",
    "api": "bun packages/api/src/main.ts",
    "admin:grant": "bun packages/api/src/admin-grant.ts",
    "backend:build": "docker compose -f docker/compose.yml --profile app build worker",
    "stack:up": "docker compose -f docker/compose.yml --profile app up -d --build",
    "stack:down": "docker compose -f docker/compose.yml --profile app down",
    "stack:logs": "docker compose -f docker/compose.yml --profile app logs -f api worker nginx"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "^7"
  }
}
