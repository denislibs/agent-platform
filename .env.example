DATABASE_URL=postgres://agent:agent@localhost:55432/agent
VALKEY_URL=redis://localhost:56379
S3_ENDPOINT=http://localhost:53900
S3_REGION=garage
S3_BUCKET=agent-files
S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Address the browser uses for presigned URLs (default: S3_ENDPOINT); in the Docker stack — http://localhost:53900
# S3_PUBLIC_ENDPOINT=
# LiteLLM: the worker refuses to start without these four; the API does not need them
LITELLM_BASE_URL=https://your-litellm.example.com/v1
LITELLM_API_KEY=
PLANNER_MODEL=deepseek
EXECUTOR_MODEL=qwen
# Evals (bun run evals): their own database next to DATABASE_URL by default; the name must end with _evals
# EVALS_DATABASE_URL=postgres://agent:agent@localhost:55432/agent_evals
# Model prices in credits per 1M tokens (defaults shown)
# PLANNER_PRICE_IN=30
# PLANNER_PRICE_OUT=120
# EXECUTOR_PRICE_IN=30
# EXECUTOR_PRICE_OUT=120
# Model context windows in tokens and tool_choice (defaults shown)
# PLANNER_CONTEXT_TOKENS=64000
# EXECUTOR_CONTEXT_TOKENS=32000
# LLM_TOOL_CHOICE=required
# Web search (optional). Without a key the agent's web_search tool reports "not configured".
BRAVE_API_KEY=
# BRAVE_BASE_URL=https://api.search.brave.com
# Worker (defaults shown)
# QUEUE_PREFIX=bull
# JOB_ATTEMPTS=3
# WORKER_CONCURRENCY=4
# SWEEP_EVERY_MS=60000
# STALE_TASK_MS=120000
# Uploads never attached to a task are deleted (record and S3 object) after this long (at least 3600000)
# UPLOAD_TTL_MS=86400000
# DB_LOCK_TIMEOUT_MS=10000
# Sandbox overrides (defaults shown)
# SANDBOX_IMAGE=agent-sandbox:dev
# SANDBOX_NETWORK=agent-sandbox
# SANDBOX_CPUS=2
# SANDBOX_MEMORY=4g
# SANDBOX_PIDS=512
# Sandbox namespace (label agent.sandbox.ns): the sweeper only sees sandboxes of its own namespace
# SANDBOX_NAMESPACE=dev
# API (defaults shown). Loopback by default; the Docker service sets 0.0.0.0 and never publishes the port
# API_HOST=127.0.0.1
# API_PORT=3000
# UPLOAD_MAX_BYTES=52428800
# SSE_HEARTBEAT_MS=15000
# Longest life of one SSE stream; it then closes without `end` and EventSource reconnects through the session check
# SSE_MAX_STREAM_MS=900000
# Auth (Better Auth). The API refuses to start without a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (nginx); OAuth callbacks are <BETTER_AUTH_URL>/api/auth/callback/<google|github>
# BETTER_AUTH_URL=http://localhost:8080
# Web app without Docker (bun run web:dev on http://localhost:5173): BETTER_AUTH_URL=http://localhost:5173
# OAuth apps: a provider is enabled only when both values are set
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Mail for magic links (SMTP of any provider: Resend, Postmark, SES, Mailgun…). Without both, links go to the API log
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Agent <noreply@example.com>
