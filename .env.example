DATABASE_URL=postgres://agent:agent@localhost:55432/agent
VALKEY_URL=redis://localhost:56379
S3_ENDPOINT=http://localhost:53900
S3_REGION=garage
S3_BUCKET=agent-files
S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LITELLM_BASE_URL=https://your-litellm.example.com/v1
LITELLM_API_KEY=
PLANNER_MODEL=deepseek
EXECUTOR_MODEL=qwen
# Model prices in credits per 1M tokens (defaults shown)
# PLANNER_PRICE_IN=30
# PLANNER_PRICE_OUT=120
# EXECUTOR_PRICE_IN=30
# EXECUTOR_PRICE_OUT=120
# Model context windows in tokens and tool_choice (defaults shown)
# PLANNER_CONTEXT_TOKENS=64000
# EXECUTOR_CONTEXT_TOKENS=32000
# LLM_TOOL_CHOICE=required
# Web search (optional). Without a key the agent's web_search tool reports "not configured".
BRAVE_API_KEY=
# BRAVE_BASE_URL=https://api.search.brave.com
# Worker (defaults shown)
# QUEUE_PREFIX=bull
# JOB_ATTEMPTS=3
# WORKER_CONCURRENCY=4
# SWEEP_EVERY_MS=60000
# STALE_TASK_MS=120000
# DB_LOCK_TIMEOUT_MS=10000
# Sandbox overrides (defaults shown)
# SANDBOX_IMAGE=agent-sandbox:dev
# SANDBOX_NETWORK=agent-sandbox
# SANDBOX_CPUS=2
# SANDBOX_MEMORY=4g
# SANDBOX_PIDS=512
# Sandbox namespace (label agent.sandbox.ns): the sweeper only sees sandboxes of its own namespace
# SANDBOX_NAMESPACE=dev
